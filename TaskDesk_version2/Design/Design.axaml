<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        
        <Style Selector="Button">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="MinWidth" Value="25"/>
                <Setter Property="MinHeight" Value="25"/>
        </Style>
        
        <Style Selector="TextBox">
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Height" Value="28"/>
        </Style>
        
        <Style Selector="TextBox.TaskDescriptionBox">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="Height" Value="375"/>
        </Style>
        
        <Style Selector="Image.PasswordVisibilityToggleImage">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
        </Style>
        
        <Style Selector="TextBlock.primary">
                <Setter Property="Margin" Value="5"/>
        </Style>
        
        <Style Selector="StackPanel.Row">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="Spacing" Value="10"/>
        </Style>
        
        <Style Selector="TextBlock.TaskProperty">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Width" Value="200"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        
        <Style Selector="Border.TaskRowBorder">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="8"/>
                <Setter Property="Margin" Value="5"/>
        </Style>
        
        <Style Selector="StackPanel.CellInAddWindows">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="Spacing" Value="8"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        
        <Style Selector="TextBox.DescriptionTextBoxInAddWindows">
                <Setter Property="MaxHeight" Value="90"/>
                <Setter Property="Height" Value="90"/>
                <Setter Property="Width" Value="200"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="5"/>
        </Style>
        
        <Style Selector="ListBox.UsersOrGroupsList">
                <Setter Property="MinWidth" Value="200"/>
                <Setter Property="Height" Value="100"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="SelectionMode" Value="Multiple, Toggle"/>
        </Style>
        
        <Style Selector="TextBlock.TaskListHeader">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Width" Value="200"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        
        <Style Selector="Separator">
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Margin" Value="5"/>
        </Style>
        
        <Style Selector="Border.NormalBorder">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="Background" Value="LightSlateGray"/>
        </Style>
        
        <Style Selector="Border.DarkGrayBorder">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="Background" Value="DarkGray"/>
        </Style>
        
        <Style Selector="Border.Pending">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="CornflowerBlue"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="CornerRadius" Value="6"/>
        </Style>
        
        <Style Selector="Border.InProgress">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="Salmon"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="CornerRadius" Value="6"/>
        </Style>
       
        <Style Selector="Border.Completed">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="ForestGreen"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="CornerRadius" Value="6"/>
        </Style>
        
        <Style Selector="Border.Cancelled">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="Red"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="CornerRadius" Value="6"/>
        </Style>
        
        <Style Selector="Border.OnHold">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="Orange"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="CornerRadius" Value="6"/>
        </Style>
        
        <Style Selector="Menu.RootMenu">
                <Setter Property="Background" Value="DarkGray"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Margin" Value="5,0,5,5"/>
        </Style>
        
        <Style Selector="Menu.RootMenu > Border">
                <Setter Property="CornerRadius" Value="6"/>
        </Style>
        
        <Style Selector="MenuItem">
                <Setter Property="Background" Value="DarkGray"/>
        </Style>
        
        <Style Selector="TextBlock.FilterLabel">
                <Setter Property="FontSize" Value="18"/>
        </Style>
        
        
</Styles>